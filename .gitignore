# .gitignore combining common Python and Angular/Node ignores

# --- Python ---
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
eggs/
*.egg-info/
pip-wheel-metadata/
wheels/
*.egg
*.dist-info/

# Virtual environments
venv/
ENV/
env/
.venv/
venv*/
env.bak/
.python-version

# Pytest/cache
.pytest_cache/

# Coverage
.coverage
.coverage.*
htmlcov/

# Test and type check
.tox/
.nox/
.mypy_cache/
.pyre/

# IDEs and editors
.vscode/
.idea/
.ropeproject/

# Local settings and environment files
local_settings.py
*.log
*.sqlite3
*.db
.env
.env.*

# PyInstaller
*.manifest
*.spec

# --- Angular / Node ---
# Node modules
node_modules/

# Build outputs
dist/
dist/**/*
out-tsc/

# Angular specific
.angular/
.angular-cache/

# Temporary files
tmp/
temp/

# Coverage and reports
coverage/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Sass / cache
.sass-cache

# Environment files (example)
src/environments/*.local.ts

# Misc
.cache/
